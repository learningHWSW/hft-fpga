# simulation / synthesis build outputs
obj_dir/
xsim.dir/
*.jou
*.pb
*.wdb
*.log
*.wcfg
xelab.pb
xvlog.pb

# python cache
__pycache__/
*.pyc

# compiled C reference/measurement tools (built from the .c beside them)
step1-sw-parser/itch_parser
step1-sw-parser/itch_hist
step1-sw-parser/otable_sim
step1-sw-parser/sym_conc

# generated test vectors and real-data slices
step1-sw-parser/test.itch
step1-sw-parser/test.mold
**/real*.itch
**/real*.mold

# large raw captures (see data/.gitignore); measurement .txt outputs are kept
*.NASDAQ_ITCH50
*.NASDAQ_ITCH50.gz
*.progress

# step 5: local run captures and synthesis outputs (reports/checkpoints are
# large and regenerable; the numbers that matter live in step5-board/README.md)
*.out
step5-board/syn/out/
.Xil/

# vivado router scratch, emitted into the working dir
step5-board/clockInfo.txt
step5-board/cong/

# step 6: shared BBO stimulus and order logs (regenerable)
step6-strategy/bbo_in.log
step6-strategy/orders_*.log
step6-strategy/ouch_*.log
step6-strategy/frames_*.log
# the full-day BBO extract behind FINDINGS 5.3: 16 MB, and one command to rebuild
step6-strategy/aapl_bbo.txt
step5-board/t2t_*.log

# generated wire-format replays (derived from licensed NASDAQ ITCH data --
# these must not be published, and real.eth is 213 MB besides). Regenerate
# with step1-sw-parser/mold2eth.py.
*.eth

# step 5: full-chain synthesis outputs and router scratch, same reasoning as
# syn/out/ above -- large, regenerable, and different on every run
step5-board/syn/out_t2t/
step5-board/iter_*_CongestedCLBsAndNets.txt
step6-strategy/sweep_*.log
step6-strategy/sweep_sum.txt
step7-host/tests/fixtures/
step7-host/**/__pycache__/

# step 1: --clean stimulus variant, same reasoning as test.itch/test.mold above
step1-sw-parser/test_clean.itch
step1-sw-parser/test_clean.mold

# step 8: Vitis/Vivado build trees and products. Everything here is regenerable
# from the RTL, the Makefile and syn/*.tcl, and it is enormous -- _x_a alone is
# 1.4 GB and t2t.xclbin is 48 MB. The numbers that matter live in step8-hw/README.md.
step8-hw/_x*/
step8-hw/ip/
step8-hw/.ipcache/
step8-hw/packaged_kernel*/
step8-hw/tmp_*/
step8-hw/analyzer_input/
step8-hw/reports_b_fail/
step8-hw/syn/out_kernel/
step8-hw/gtgate/packaged/
step8-hw/gtgate/tmp_pack/
step8-hw/gtgate/_xg/
step8-hw/gtgate/analyzer_input/

# generated by gen_vitis_ini*.sh at build time, and they embed absolute paths
step8-hw/syn/vitis.ini
step8-hw/syn/vitis_b.ini

# build products and host binary
*.xclbin
*.xclbin.info
*.xclbin.link_summary
*.xo
*.ltx
step8-hw/host/t2t_run

# replay/capture images: derived from licensed NASDAQ ITCH data (must not be
# published) and 312 MB besides. Regenerate with scripts/pack_eth.py.
step8-hw/*.bin
